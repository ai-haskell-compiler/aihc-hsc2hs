cabal-version: 3.0
name: aihc-hsc2hs
version: 0.1.0.0
synopsis: Compile-only hsc2hs using Clang object data
license: Unlicense
license-file: LICENSE
build-type: Simple
category: Development
extra-source-files: README.md

library
  exposed-modules: Hsc2hs Hsc2hs.Object
  hs-source-dirs: src
  build-depends: base >=4.16 && <5, bytestring, containers, directory, filepath, process, temporary, text
  default-language: Haskell2010
  ghc-options: -Wall

executable aihc-hsc2hs
  main-is: Main.hs
  hs-source-dirs: app
  build-depends: base, aihc-hsc2hs, bytestring, directory, filepath
  default-language: Haskell2010
  ghc-options: -Wall

test-suite unit
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends: base, aihc-hsc2hs, bytestring, containers, directory, filepath, process, temporary
  default-language: Haskell2010
  ghc-options: -Wall
